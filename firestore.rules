rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Each authenticated user has read & write permissions ONLY to their own profile and all subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // All nested subcollections (medical_records, medications, appointments, timeline_events, screening_history)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Explicitly deny read & write to any collection or document outside of /users/{userId}
    match /{document=**} {
      allow read, write: false;
    }
  }
}
